{
  "name": "werk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/cli.ts serve",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=4 --timeout=15000",
    "test:coverage": "bun test --parallel=4 --timeout=15000 --coverage --coverage-reporter=text --coverage-reporter=lcov && bun src/test/coverage-gate.ts",
    "e2e": "playwright test --pass-with-no-tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "react": "19.3.1"
  }
}
