{
  "name": "werk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WERK_DEV=1 bun src/cli.ts serve",
    "lint": "biome check . && bun src/claude/check-subagent-links.ts",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=4 --timeout=15000",
    "test:coverage": "bun test --parallel=4 --timeout=15000 --coverage --coverage-reporter=text --coverage-reporter=lcov && bun src/test/coverage-gate.ts",
    "e2e": "playwright test --pass-with-no-tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
