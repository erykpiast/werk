      "title": "A conversation is named, and every request and live part carries its name",
      "ticket": "werk/55",
      "pending": true
    },
    {
      "card": "werk-mc-tabs-new-button",
      "title": "A plus button in the tab strip opens a new conversation on the open card",
      "ticket": "werk/55",
      "pending": true
    },
    {
      "card": "werk-mc-split-convo-name-address",
      "title": "A conversation name travels in the convo query parameter, and a missing name means main",
      "ticket": "werk/55",
      "pending": true
    },
    {
      "card": "werk-write-card-neighbours",
      "title": "A card page lists every neighbour of the card, under one heading for each link type and direction",
      "ticket": "werk/60",
      "pending": true
    },
    {
      "card": "werk-v0-seams-fake-script",
      "title": "The fake agent replays a script of ordered steps: an event to print, or a file to write",
      "ticket": "werk/61",
      "pending": false
    },
    {
      "card": "werk-chat-image-inline-page-size-check",
      "title": "The page refuses an oversized image before it uploads",
      "ticket": "werk/63",
      "pending": true
    },
    {
      "card": "werk-write-add-root",
      "title": "A card added with no parent sits under the root",
      "ticket": "werk/64",
      "pending": true
    },
    {
      "card": "werk-write-staged-removal",
      "title": "An agent's removal is a staged change, and its accept takes the card out",
      "ticket": "werk/65",
      "pending": true
    },
    {
      "card": "werk-remove-restore-undo",
      "title": "A restore undoes the whole removal, the moved children too",
      "ticket": "werk/66",
      "pending": false
    },
    {
      "card": "werk-cli-retitle",
      "title": "`werk retitle` and `werk edit --body` replace the words of an open card with one event each",
      "ticket": "werk/67",
      "pending": true
    },
    {
      "card": "vi-prop-nolineage-ghost",
      "title": "A ghost card cannot take its proposed parent as a depends_on basis",
      "ticket": "werk/68",
      "pending": true
    },
    {
      "card": "werk-write-open-root-basis",
      "title": "A root that is not decided is no basis for the cards under it",
      "ticket": "werk/74",
      "pending": true
    },
    {
      "card": "werk-cli-show-removed",
      "title": "Showing a removed card says that it is removed and names the restore",
      "ticket": "werk/75",
      "pending": true
    },
    {
      "card": "ms-store-events",
      "title": "The pipeline log has four event types, and one run id joins the events of a plan",
      "ticket": "werk/77",
      "pending": true
    },
    {
      "card": "ms-store-addresses",
      "title": "Detail files live in fixed folders beside the pipeline log, and git ignores them",
      "ticket": "werk/77",
      "pending": true
    },
    {
      "card": "ms-store-plancopy-kept",
      "title": "A kept ticket is an open ticket whose file is the same before and after the plan",
      "ticket": "werk/77",
      "pending": true
    },
    {
      "card": "ms-store-nousage",
      "title": "A session that reports no cost is logged as zero cost and zero tokens",
      "ticket": "werk/77",
      "pending": true
    },
    {
      "card": "ms-store-addresses-copy-layout",
      "title": "A plan copy folder holds the spec, a folder of tickets, and one answer file per writer",
      "ticket": "werk/77",
      "pending": true
    },
    {
      "card": "ms-store-events-orphans",
      "title": "A fold of the pipeline log sets aside an event that has no start before it",
      "ticket": "werk/77",
