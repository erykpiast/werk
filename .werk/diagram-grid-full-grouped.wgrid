# #vi-sysdiag-grid at scale, grouped layout. Same diagram as diagram-grid-full-minimal.wgrid.
# The content section is a byte copy. Only this header and the grid section differ.
#
# Why: a group frame is the bounding box of its member cards. In the minimal grid the groups
# interleave, so SERVER PROCESS framed 10 cards that are not its members and STORE framed 7.
# Here each group is one compact block, and the blocks do not overlap. The build prints no
# "frames N card(s) that are not its members" warning.
#
# Layout: BUILD LOOP on the left, with BUILDER LOOP as a 2x2 ring inside it. MAP VIEW and
# CHAT PANE are on top. SERVER PROCESS is below them, STORE below that. child, cli and tracker
# belong to no group, so they sit between the blocks. cli is under STORE. child is right of
# STORE, with the TEST HARNESS and SAMPLING blocks next to it.
#
# Cards are 1 cell wide unless a face carries several edges. A wide card is an odd number of
# cells, so a single edge can use the middle cell. Edges cross only on explicit junctions.
# The cells were placed by a router script kept outside the repo, then read back by the build.

content
  flowchart TD
    subgraph mapview [MAP VIEW]
      tree["refines tree | the decision tree, as a list you open and close; a proposed card shows as a ghost"] @vi-onview,vi-overwrite,werk-propose-new
      graph3d["3d graph | the same cards, drawn as a 3D web of links"] @vi-graph3d,vi-graph3d-highlight,vi-graph3d-paused
      detail["card detail | the full text of one card"] @vi-detail,vi-onview,werk-reflink,werk-codeblock
      rollup["rollup bar | counts of decided, open, and stale cards"] @rollup,ro-axes,ro-inline
      diagram["system diagram | this picture, drawn by the grid pipeline from a hand-authored .wgrid file"] @vi-sysdiag,vi-sysdiag-render,vi-sysdiag-link
      board["ticket board | one column per ticket state: blocked, ready, building, merging, done"] @werk-board,vi-board,werk-board-columns,werk-board-control
    end
    subgraph pane [CHAT PANE]
      approvebar["approval bar | shows the call and the CLI's reason; allow once, always allow, or deny"] @werk-approve,werk-approve-bar
      composer["composer | the box where you type"] @werk-chat,werk-shot-chip,werk-hash-trigger,werk-chat-cmdmenu
      transcript["transcript | the chat history, with a button for the suggested next action"] @werk-progress,werk-tool-collapse,werk-mc-askqa,werk-mc-nextbtn
      tabs["tab strip | one tab per conversation; its dot blinks for a pending ask or a dead child"] @werk-multichat,werk-mc-tabs,werk-mc-park,werk-mc-keys,werk-mc-scope,werk-mc-asks,werk-mc-asks-dot,werk-mc-live
      header["model + context header | which model runs, and how much context is left"] @werk-model-select,werk-context-pie,werk-head-bottom
    end
    subgraph proc [SERVER PROCESS]
      state["state | GET /api/graph, one fetch of today's folded map"] @werk,vi-edges,vi-overwrite
      live["live + sse | POST /api/chat, /api/ask, and the SSE stream back"] @werk-pane,werk-progress,werk-crash
      foldfn["fold | turns the log of past decisions into today's state"] @werk,pr-log
      runner["conversation manager | one agent per conversation, each forked from its parent's session at a home card"] @werk-invoke,werk-chat-stdin,werk-resume,werk-multichat,werk-mc-fork,werk-mc-split
      gate["ask queue | holds the calls Claude Code's own engine could not decide; werk decides nothing itself"] @werk-perm-native,werk-perm-mode,werk-approve
      accept["accept + remove | commits a ghost with its ghost parents, or removes a card with its subtree"] @werk-propose-new,werk-remove
      lock["one-server lock | stops two servers running at once"] @werk-onelock
      dev["dev reload | reloads code changes without losing a live chat"] @werk-dev,werk-hmr
    end
    subgraph store [STORE]
      log["log.jsonl | every decision, ever made, in order"] @pr-log,werk,werk-two-files
      chatlog["conversations | one session id and one chat.jsonl per conversation"] @werk-two-files,werk-resume,werk-blockid,werk-multichat,werk-mc-fork
      allow["allow.json | always-allow rules the CLI suggested, kept per conversation and given to that conversation's next child"] @werk-perm-native,werk-approve,werk-mc-allow
      asks["asks.jsonl | every answered approval question"] @werk-approve-log
    end
    subgraph test [TEST HARNESS]
      unittest["bun test | src/ and React component tests; 90% line gate on the pure modules"] @werk-test-runner,werk-test-scope
      e2e["playwright e2e | boots the real server in Chromium, asserts on the DOM, writes a PNG as evidence"] @werk-test-visual,werk-test-visual-judge
    end
    subgraph buildloop [BUILD LOOP]
      planner["planner | one decided subtree becomes one spec, then tracer-bullet tickets"] @werk-loop,st-spec,st-ticket,st-ticket-stories
      subgraph builderloop [BUILDER LOOP]
        implement["implement | a fresh builder agent does one unit of work toward the ticket, in its own worktree; up to 3 tickets at once"] @st-build-ticket,st-build-implement,st-build-parallel,werk-loop-fanout,werk-loop
        check["check | one command per check, exit code only"] @lp-checks,st-build-ticket
        grade["grade | a grader agent reads the diff against each decided card, score 1-5"] @lp-prod-judge,st-build-ticket
        review["review | five reviewer agents, one per quality area, read the diff"] @lp-prod-review,st-build-ticket
      end
      merger["merge loop | merges one finished ticket at a time on green checks"] @werk-loop,st-build-run
      heldout["held-out set | Given/When/Then steps the builder never sees, bound to tests by a binder agent"] @werk-loop,st-validate-heldout,lp-prod-heldout,lp-heldout-steps,lp-heldout-author,lp-heldout-binder
      overseer["overseer | plain code that watches every agent session and acts on a stuck one"] @werk-loop,lp-overseer,lp-overseer-det
    end
    subgraph sampling [SAMPLING]
      sampler["sample runner | N one-shot claude --print agents on one brief; a fork is where their manifests diverge"] @al-sample,al-sample-runner,al-sample-noask,al-sample-diverge,al-sample-budget
      prototyper["prototype runner | builds one artifact per option of a fork, in parallel"] @al-sample-proto-agent,al-sample-artifact,al-sample-build-isolation
    end
    cli["cli | the only write path; it stages every new card and checks the contract before decided"] @werk-write,werk-contract,werk-contract-where,werk-propose-new
    child["claude code child | the Claude Code process doing the work"] @werk-invoke,werk-chat-stdin
    tracker["issue tracker | an outside tool, like Linear or GitHub"] @tracker,tk-verbs,vi-backend

    tree -->|loads the card tree| state @vi-onview
    graph3d -->|loads nodes and edges| state @vi-graph3d
    detail -->|loads one card's full text| state @vi-detail
    rollup -->|loads decided, open, and stale counts| state @rollup
    tree -->|the check button accepts a ghost| accept @werk-propose-new
    detail -->|the cross button removes the card| accept @werk-remove
    tree -->|shift+click forks a conversation at that card| live @werk-mc-open
    accept -->|appends the events| log @werk-propose-new,werk-remove
    approvebar -->|asks before a risky action runs| live @werk-approve
    composer -->|sends what you type| live @werk-chat
    transcript -->|streams the reply as it is written| live @werk-progress
    tabs -->|switches which chat is live| live @werk-mc-follow
    header -->|shows the model and context left| live @werk-model-select
    state -->|asks for today's state| foldfn @werk,vi-overwrite
    foldfn -->|reads every past decision| log @pr-log
    live -->|starts the agent for a message| runner @werk-chat-stdin
    runner -->|runs one child per conversation| child @werk-invoke,werk-multichat
    runner -->|saves each conversation| chatlog @werk-two-files,werk-multichat
    runner -->|checks no other server is running| lock @werk-onelock
    runner -->|starts the next child with the saved rules| allow @werk-perm-native
    child -->|sends a call its own engine could not decide| gate @werk-perm-native
    gate -->|keeps the always-allow rules| allow @werk-perm-native
    gate -->|appends each answered question| asks @werk-approve-log
    gate -->|asks you when unsure| approvebar @werk-approve
    child -->|changes the map| cli @werk-write
    cli -->|appends the change| log @pr-log,werk-write
    cli -->|convos and recall read a sibling's transcript| chatlog @werk-mc-recall
    log -->|copies a decision out| tracker @vi-backend,tk-verbs
    dev -->|reloads the server on a code change| runner @werk-hmr
    child -->|runs the two test commands itself| unittest @werk-test
    child -->|runs the browser flows itself| e2e @werk-test
    e2e -->|boots the real server and drives the live routes| live @werk-test-visual
    child -->|writes the diagram source directly, no log entry| diagram @vi-sysdiag-grid-lanewall,vi-sysdiag-grid-junction
    planner -->|reads one decided subtree, writes any new decision back| cli @st-spec
    planner -->|puts the tickets on the board| board @st-ticket,vi-board
    board -->|triggers or stops one ticket's build| implement @werk-board-control
    implement -->|runs the checks on the diff| check @st-build-ticket
    check -->|green: grade the diff| grade @st-build-ticket
    grade -->|pass: review the diff| review @st-build-ticket
    check -->|red: a new pass with the failure| implement @st-build-ticket,lp-stateless
    grade -->|fail: a new pass with the gap| implement @lp-prod-judge,lp-stateless
    review -->|CRITICAL or HIGH: a new pass with the findings| implement @lp-prod-review,lp-stateless
    review -->|queues a finished ticket| merger @st-build-run
    merger -->|sends a red ticket back with the failure| implement @st-build-run
    merger -->|runs the held-out set on the merged tree| heldout @st-build-run,st-validate-heldout
    heldout -->|sends the text of a failed step| implement @lp-heldout-feedback
    merger -->|moves tickets through merging and done| board @werk-board-columns
    overseer -->|watches each agent session for a stuck one| implement @lp-overseer,lp-overseer-det
    child -->|spawns the sampler subagent| sampler @al-sample-agent
    child -->|spawns the prototyper subagent| prototyper @al-sample-proto-agent

    class tree,graph3d,detail,rollup,diagram,board,approvebar,composer,transcript,tabs,header read
    class state,live,foldfn,runner,gate,accept,lock,overseer state
    class dev,unittest,e2e dev
    class log,chatlog,allow,asks write
    class cli,child,planner,implement,grade,review,merger,heldout,sampler,prototyper agent
    class tracker ext

