{
  "name": "werk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "werk v0. An append-only decision log, folded into a map.",
  "bin": {
    "werk": "./src/cli.ts"
  },
  "scripts": {
    "serve": "bun src/cli.ts serve",
    "dev": "bun --hot src/cli.ts serve",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage && bun tools/coverage-gate.ts coverage/lcov.info",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test tools e2e",
    "e2e": "playwright test"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  }
}
