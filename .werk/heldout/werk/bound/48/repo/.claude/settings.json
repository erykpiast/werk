{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make help)",
      "Bash(make dev)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make test-coverage)",
      "Bash(make e2e)",
      "Bash(make check)",
      "Bash(make fix)",
      "Bash(make build)",
      "Bash(werk:*)",
      "Bash(bun src/cli.ts:*)",
      "Bash(./src/cli.ts:*)"
    ],
    "ask": [
      "Bash(werk accept:*)",
      "Bash(werk remove:*)",
      "Bash(werk restore:*)",
      "Bash(bun src/cli.ts accept:*)",
      "Bash(bun src/cli.ts remove:*)",
      "Bash(bun src/cli.ts restore:*)",
      "Bash(./src/cli.ts accept:*)",
      "Bash(./src/cli.ts remove:*)",
      "Bash(./src/cli.ts restore:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/format-hook.ts\"", "timeout": 30 }]
      }
    ]
  }
}
