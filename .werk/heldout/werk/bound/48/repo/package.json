{
  "name": "werk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A visual layer over Claude Code: a decision map folded from an append-only log, a ticket board, and a chat pane.",
  "scripts": {
    "dev": "bun --hot src/cli.ts serve",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --parallel=4 --timeout=15000",
    "test:coverage": "bun scripts/coverage-gate.ts",
    "e2e": "playwright test --pass-with-no-tests",
    "build": "bun build --compile src/cli.ts --outfile dist/werk"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
