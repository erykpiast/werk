<g class="wd-node" data-node="tree" data-cards="vi-onview,vi-overwrite,werk-propose-new,vi-onview-postponed,vi-board-plan,werk-board-build-subtree,vi-onview-root,vi-board-plan-controls,vi-home-howwhat,vi-home-howwhat-address,vi-home-howwhat-open"><rect x="2522.19" y="393" width="360.53" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="2702.45" y="439" font-weight="700" font-size="12.5">refines tree</tspan><tspan x="2702.45" y="461" font-size="10" fill="#9fb0c4">the decision tree, as a list you open</tspan><tspan x="2702.45" y="474" font-size="10" fill="#9fb0c4">and close; a proposed card shows as a</tspan><tspan x="2702.45" y="487" font-size="10" fill="#9fb0c4">ghost; a decided card carries a Build</tspan><tspan x="2702.45" y="500" font-size="10" fill="#9fb0c4">button</tspan></text></g>
<g class="wd-node" data-node="graph3d" data-cards="vi-graph3d-highlight,vi-graph3d-paused"><rect x="2896.71" y="393" width="212.36" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="3002.89" y="452" font-weight="700" font-size="12.5">3d graph</tspan><tspan x="3002.89" y="474" font-size="10" fill="#9fb0c4">the same cards, drawn as a 3D web of</tspan><tspan x="3002.89" y="487" font-size="10" fill="#9fb0c4">links</tspan></text></g>
