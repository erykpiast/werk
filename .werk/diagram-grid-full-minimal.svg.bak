<g class="wd-node" data-node="rollup" data-cards="rollup,ro-axes,ro-inline,vi-onview-postponed"><rect x="3278.08" y="393" width="211.5" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="3383.83" y="452" font-weight="700" font-size="12.5">rollup bar</tspan><tspan x="3383.83" y="474" font-size="10" fill="#9fb0c4">counts of decided, open, and stale</tspan><tspan x="3383.83" y="487" font-size="10" fill="#9fb0c4">cards</tspan></text></g>
<g class="wd-node" data-node="diagram" data-cards="vi-sysdiag,vi-sysdiag-link,vi-sysdiag-declare,vi-sysdiag-compare,vi-sysdiag-nokind,vi-sysdiag-grid,vi-sysdiag-metrics,vi-sysdiag-grid-inline-label,vi-sysdiag-grid-gaps,vi-sysdiag-file"><rect x="3503.58" y="393" width="358.33" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="3682.75" y="452" font-weight="700" font-size="12.5">system diagram</tspan><tspan x="3682.75" y="474" font-size="10" fill="#9fb0c4">this picture, drawn by the grid pipeline</tspan><tspan x="3682.75" y="487" font-size="10" fill="#9fb0c4">from a hand-authored .wgrid file</tspan></text></g>
<g class="wd-node" data-node="board" data-cards="werk-board,vi-board,werk-board-columns,werk-board-control,vi-board-plan,vi-board-details,werk-board-colwidth,st-ticket-restore,vi-board-session-file,vi-board-plan-controls,vi-board-title-clamp,vi-board-ticket-decisions-2"><rect x="97" y="393" width="1720.98" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="957.49" y="452" font-weight="700" font-size="12.5">ticket board</tspan><tspan x="957.49" y="474" font-size="10" fill="#9fb0c4">one column per ticket state: blocked,</tspan><tspan x="957.49" y="487" font-size="10" fill="#9fb0c4">ready, building, merging, done</tspan></text></g>
<g class="wd-node" data-node="flow" data-cards="vi-flowtab-removed"><rect x="3875.91" y="286" width="441.16" height="93" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="4096.49" y="306" font-weight="700" font-size="12.5">flow tab</tspan><tspan x="4096.49" y="328" font-size="10" fill="#9fb0c4">counts from the map cards: the status</tspan><tspan x="4096.49" y="341" font-size="10" fill="#9fb0c4">loop, totals for each subtree, and a flat</tspan><tspan x="4096.49" y="354" font-size="10" fill="#9fb0c4">list of all cards</tspan></text></g>
<g class="wd-node" data-node="measure" data-cards="ms-outcome-interv-chat,vi-flow-localrate,lp-overseer-psfail-metric,werk-write-measure-signal,ms-col-time"><rect x="3875.91" y="393" width="586.15" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="4168.99" y="426" font-weight="700" font-size="12.5">measure tab</tspan><tspan x="4168.99" y="448" font-size="10" fill="#9fb0c4">measures from the pipeline log, the</tspan><tspan x="4168.99" y="461" font-size="10" fill="#9fb0c4">board log, the conversations and the</tspan><tspan x="4168.99" y="474" font-size="10" fill="#9fb0c4">background jobs: chat-pane waits, the</tspan><tspan x="4168.99" y="487" font-size="10" fill="#9fb0c4">share of local diagram redraws, each</tspan><tspan x="4168.99" y="500" font-size="10" fill="#9fb0c4">ticket's time per board column, and</tspan><tspan x="4168.99" y="513" font-size="10" fill="#9fb0c4">kill-criterion gauges</tspan></text></g>
<g class="wd-node" data-node="switcher" data-cards="werk-projects-switcher,werk-projects-add,werk-projects-background,werk-projects-display,werk-projects-names,werk-v0-onechat"><rect x="7665.38" y="393" width="212.77" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="7771.77" y="413" font-weight="700" font-size="12.5">project switcher</tspan><tspan x="7771.77" y="435" font-size="10" fill="#9fb0c4">the current project's name at the left</tspan><tspan x="7771.77" y="448" font-size="10" fill="#9fb0c4">of the sticky header; its menu lists</tspan><tspan x="7771.77" y="461" font-size="10" fill="#9fb0c4">every project, marks each one with a</tspan><tspan x="7771.77" y="474" font-size="10" fill="#9fb0c4">running agent turn or a dead agent,</tspan><tspan x="7771.77" y="487" font-size="10" fill="#9fb0c4">and ends with Add project…, which</tspan><tspan x="7771.77" y="500" font-size="10" fill="#9fb0c4">opens the operating system's folder</tspan><tspan x="7771.77" y="513" font-size="10" fill="#9fb0c4">dialog; a switch reopens that project's</tspan><tspan x="7771.77" y="526" font-size="10" fill="#9fb0c4">last card and view</tspan></text></g>
<g class="wd-node" data-node="search" data-cards="vi-jump,vi-jump-hash,vi-jump-row"><rect x="7206.52" y="393" width="217.68" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="7315.36" y="426" font-weight="700" font-size="12.5">search box</tspan><tspan x="7315.36" y="448" font-size="10" fill="#9fb0c4">a box in the header that opens any</tspan><tspan x="7315.36" y="461" font-size="10" fill="#9fb0c4">card, option, source or excerpt by its</tspan><tspan x="7315.36" y="474" font-size="10" fill="#9fb0c4">id or its words; a query that starts with</tspan><tspan x="7315.36" y="487" font-size="10" fill="#9fb0c4"># matches ids only, exact id first; each</tspan><tspan x="7315.36" y="500" font-size="10" fill="#9fb0c4">result shows a status-color dot and the</tspan><tspan x="7315.36" y="513" font-size="10" fill="#9fb0c4">card id</tspan></text></g>
<g class="wd-node" data-node="viewtabs" data-cards="vi-tabs,vi-routes"><rect x="7438.2" y="393" width="213.18" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="7544.79" y="445.5" font-weight="700" font-size="12.5">view tabs</tspan><tspan x="7544.79" y="467.5" font-size="10" fill="#9fb0c4">one tab per view in the header; a click</tspan><tspan x="7544.79" y="480.5" font-size="10" fill="#9fb0c4">opens that view at its own address,</tspan><tspan x="7544.79" y="493.5" font-size="10" fill="#9fb0c4">and the view in use is kept per project</tspan></text></g>
<g class="wd-node" data-node="approvebar" data-cards="werk-approve,werk-approve-bar"><rect x="4675.75" y="393" width="209.9" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="4780.7" y="452" font-weight="700" font-size="12.5">approval bar</tspan><tspan x="4780.7" y="474" font-size="10" fill="#9fb0c4">shows the call and the CLI's reason;</tspan><tspan x="4780.7" y="487" font-size="10" fill="#9fb0c4">allow once, always allow, or deny</tspan></text></g>
<g class="wd-node" data-node="composer" data-cards="werk-chat,werk-shot-chip,werk-hash-trigger,werk-chat-cmdmenu,werk-chat-image-inline"><rect x="4899.66" y="393" width="213.9" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="5006.61" y="458.5" font-weight="700" font-size="12.5">composer</tspan><tspan x="5006.61" y="480.5" font-size="10" fill="#9fb0c4">the box where you type</tspan></text></g>
<g class="wd-node" data-node="transcript" data-cards="werk-progress,werk-tool-collapse,werk-mc-askqa,werk-mc-nextbtn,werk-chat-turn-id,werk-mc-tab-bottom"><rect x="5275.31" y="393" width="208.25" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="5379.44" y="452" font-weight="700" font-size="12.5">transcript</tspan><tspan x="5379.44" y="474" font-size="10" fill="#9fb0c4">the chat history, with a button for the</tspan><tspan x="5379.44" y="487" font-size="10" fill="#9fb0c4">suggested next action</tspan></text></g>
<g class="wd-node" data-node="bgline" data-cards="werk-mc-bgagents,werk-mc-bg-line"><rect x="5956.37" y="393" width="216.94" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="6064.84" y="452" font-weight="700" font-size="12.5">background-agents line</tspan><tspan x="6064.84" y="474" font-size="10" fill="#9fb0c4">a line pinned under the chat log while a</tspan><tspan x="6064.84" y="487" font-size="10" fill="#9fb0c4">background agent of this tab still runs</tspan></text></g>
<g class="wd-node" data-node="deadbar" data-cards="werk-mc-live-dead,werk-mc-live-line"><rect x="6187.31" y="393" width="215.29" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="6294.95" y="432.5" font-weight="700" font-size="12.5">attention bar</tspan><tspan x="6294.95" y="454.5" font-size="10" fill="#9fb0c4">one line per tab that needs the person,</tspan><tspan x="6294.95" y="467.5" font-size="10" fill="#9fb0c4">shown in the pane of every other tab,</tspan><tspan x="6294.95" y="480.5" font-size="10" fill="#9fb0c4">naming the tab and its reason in the</tspan><tspan x="6294.95" y="493.5" font-size="10" fill="#9fb0c4">reason's color: dead, permission,</tspan><tspan x="6294.95" y="506.5" font-size="10" fill="#9fb0c4">question, or offer</tspan></text></g>
<g class="wd-node" data-node="tabs" data-cards="werk-mc-tabs,werk-mc-park,werk-mc-keys,werk-mc-asks,werk-mc-asks-dot,werk-mc-live,werk-mc-bgagents,werk-mc-live-bgcount,werk-mc-tabs-step-wrap,werk-mc-live-dead,werk-mc-live-line,werk-mc-split-plus"><rect x="5497.57" y="393" width="216.45" height="158" rx="8" fill="#1b2536" stroke="#3a4a5f" stroke-width="1.4"/><text text-anchor="middle" fill="#eef2f7"><tspan x="5605.79" y="445.5" font-weight="700" font-size="12.5">tab strip</tspan><tspan x="5605.79" y="467.5" font-size="10" fill="#9fb0c4">one tab per conversation; its dot blinks</tspan><tspan x="5605.79" y="480.5" font-size="10" fill="#9fb0c4">in the color of what the tab needs:</tspan><tspan x="5605.79" y="493.5" font-size="10" fill="#9fb0c4">dead, permission, question, or offer</tspan></text></g>
