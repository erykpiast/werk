flowchart TD

  subgraph browser["browser"]
    subgraph mapview["map view"]
      tree["`**refines tree**
the decision tree, as a list you open and close`"]
      graph3d["`**3d graph**
the same cards, drawn as a 3D web of links`"]
      detail["`**card detail**
the full text of one card`"]
      rollup["`**rollup bar**
counts of decided, open, and stale cards`"]
    end
    subgraph pane["chat pane"]
      composer["`**composer**
the box where you type`"]
      transcript["`**transcript**
the chat history`"]
      approvebar["`**approval bar**
asks you to allow or deny a risky action`"]
      tabs["`**tab strip**
one tab per chat`"]
      header["`**model + context header**
which model runs, and how much context is left`"]
    end
  end

  subgraph proc["server process"]
    state["`**state**
GET /api/graph — one fetch of today's folded map`"]
    live["`**live + sse**
POST /api/chat, /api/ask, and the SSE stream back`"]
    foldfn["`**fold**
turns the log of past decisions into today's state`"]
    runner["`**agent runner**
runs the agent that answers you`"]
    gate["`**permission gate**
decides if a tool call may run`"]
    lock["`**one-server lock**
stops two servers running at once`"]
    dev["`**dev reload**
reloads code changes without losing a live chat`"]
  end

  subgraph store["store"]
    log[("`**log.jsonl**
every decision, ever made, in order`")]
    chatlog[("`**chat.jsonl**
the saved chat messages`")]
    allow[("`**allow.json**
tool calls you already said yes to`")]
  end

  cli["`**cli**
the commands that read and write the map`"]
  child["`**claude code child**
the Claude Code process doing the work`"]
  tracker["`**issue tracker**
an outside tool, like Linear or GitHub`"]

  tree -->|loads the card tree| state
  graph3d -->|loads nodes and edges| state
  detail -->|loads one card's full text| state
  rollup -->|loads decided, open, and stale counts| state
  composer -->|sends what you type| live
  transcript -->|streams the reply as it is written| live
  approvebar -->|asks before a risky action runs| live
  tabs -->|switches which chat is live| live
  header -->|shows the model and context left| live

  state -->|asks for today's state| foldfn
  foldfn -->|reads every past decision| log
  live -->|starts the agent for a message| runner
  runner -->|runs the agent| child
  runner -->|saves the conversation| chatlog
  runner -->|checks no other server is running| lock
  child -. checks before a tool runs .-> gate
  gate -->|checks the saved yes/no list| allow
  gate -. asks you when unsure .-> approvebar
  child -->|changes the map| cli
  cli -->|appends the change| log
  log -. copies a decision out .-> tracker
  dev -->|reloads the server on a code change| proc

